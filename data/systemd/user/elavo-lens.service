[Unit]
Description=Elavo Lens
Documentation=https://github.com/elavo-io/elavo-folio
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
ExecStart=/usr/bin/elavo-lens
Restart=on-failure
RestartSec=1
# Applications launched from Lens run in this unit's cgroup. Restarting
# Lens must not take them down with it.
KillMode=process
Slice=session.slice

[Install]
WantedBy=graphical-session.target
