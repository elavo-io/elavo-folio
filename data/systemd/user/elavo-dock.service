[Unit]
Description=Elavo dock
Documentation=https://github.com/elavo-io/elavo-shell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
ExecStart=/usr/bin/elavo-dock
Restart=on-failure
RestartSec=1
# Applications launched from the dock run in this unit's cgroup. Restarting
# the dock must not take them down with it.
KillMode=process
Slice=session.slice

[Install]
WantedBy=graphical-session.target
