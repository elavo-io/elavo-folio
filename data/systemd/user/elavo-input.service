[Unit]
Description=Elavo text input
Documentation=https://github.com/elavo-io/elavo-folio
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
ExecStart=/usr/bin/elavo-input
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
