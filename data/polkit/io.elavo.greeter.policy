<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Elavo</vendor>
  <vendor_url>https://github.com/elavo-io/elavo-folio</vendor_url>

  <!-- elavo-wallpaper copies the session's wallpaper for the login screen
       each time it paints. The active session never needs a password. -->
  <action id="io.elavo.greeter.publish-wallpaper">
    <description>Show your wallpaper on the login screen</description>
    <message>Authentication is required to show your wallpaper on the login screen</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-greeter-publish</annotate>
  </action>
</policyconfig>
